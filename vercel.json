{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/clear-passkeys",
      "destination": "/clear-passkey-management",
      "permanent": true
    },
    {
      "source": "/cd-player",
      "destination": "/burned",
      "permanent": true
    },
    {
      "source": "/mix-cd",
      "destination": "/burned",
      "permanent": true
    },
    {
      "source": "/mix-cd-player",
      "destination": "/burned-player",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/lib/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=2592000"
        }
      ]
    }
  ]
}
